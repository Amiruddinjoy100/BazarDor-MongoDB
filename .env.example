# API given in the assignment. Set to the other documented endpoint if unavailable.
BAZARDOR_API_URL=https://api.abcz.workers.dev/api/bazardor

# Use MongoDB Atlas or local MongoDB (Better Auth user/account/session collections).
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bazardor

# Run: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000

# Create OAuth apps and supply both values (optional for local email/password tests)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
